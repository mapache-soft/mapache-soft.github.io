---
import Layout from '../layouts/Layout.astro';
import { defaultLocale, notFound } from '../i18n';
import { url } from '../lib/url';

const locale = defaultLocale;
const c = notFound[locale];
---

<Layout title={c.title} description={c.description} locale={locale} pagePath="/">
	<section class="hero">
		<div class="container">
			<p class="eyebrow">{c.eyebrow}</p>
			<h1>{c.h1}</h1>
			<p class="lede">{c.lede}</p>
			<div class="hero-actions">
				<a class="button" href={url('/', locale)}>{c.home}</a>
				<a class="button-secondary" href="mailto:hola@mapache-soft.com">{c.contact}</a>
			</div>
		</div>
	</section>
</Layout>
