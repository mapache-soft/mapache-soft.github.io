---
import '@fontsource/ubuntu/latin-500.css';
import '@fontsource/ubuntu/latin-700.css';
import logoMark from '../assets/logo.svg';
import { url } from '../lib/url';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Mapache Softworks',
	description = 'Independent software company for thoughtful Mac apps and product-minded engineering consulting.',
} = Astro.props;

const navItems = [
	{ href: url('/'), label: 'Home' },
	{ href: url('/apps/'), label: 'Apps' },
	{ href: url('/services/'), label: 'Services' },
	{ href: url('/about/'), label: 'About' },
	{ href: url('/impressum/'), label: 'Impressum' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffeded" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#061a1c" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<link rel="icon" href={url('/favicon.ico')} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<div class="container header-grid">
				<a class="brand" href={url('/')} aria-label="Mapache Softworks home">
					<img
						class="brand-mark"
						src={logoMark.src}
						width="48"
						height="48"
						alt=""
					/>
					<span class="brand-wordmark" aria-hidden="true">
						<span>Mapache</span>
						<span>Softworks</span>
					</span>
				</a>
				<nav aria-label="Primary navigation">
					<ul>
						{navItems.map((item) => (
							<li>
								<a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container footer-grid">
				<div class="footer-meta">
					<p>© 2026 Mapache Softworks. All rights reserved.</p>
					<p class="footer-credit">
						Logo & colour theme by
						<a href="https://www.kirionearth.com" rel="noopener noreferrer" target="_blank">Kiri</a>
					</p>
				</div>
				<nav aria-label="Footer navigation">
					<a href={url('/impressum/')}>Impressum</a>
					<a href={url('/privacy/')}>Privacy</a>
					<a href={url('/cookies/')}>Cookies</a>
					<a href={url('/terms/')}>Terms</a>
					<a href="mailto:hola@mapache-soft.com">hola@mapache-soft.com</a>
				</nav>
			</div>
		</footer>
		<script is:inline>
			(function () {
				var reduce =
					window.matchMedia &&
					window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				var nodes = document.querySelectorAll('.reveal');
				if (!nodes.length) return;
				if (reduce || !('IntersectionObserver' in window)) {
					for (var i = 0; i < nodes.length; i++) {
						nodes[i].classList.add('is-visible');
					}
					return;
				}
				document.documentElement.classList.add('has-reveal');
				var io = new IntersectionObserver(
					function (entries) {
						for (var j = 0; j < entries.length; j++) {
							var entry = entries[j];
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					},
					{ rootMargin: '0px 0px -48px 0px', threshold: 0 },
				);
				for (var k = 0; k < nodes.length; k++) {
					io.observe(nodes[k]);
				}
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--palette-moonlight: #ffeded;
		--palette-frost: #e3effc;
		--palette-glacier: #dccbff;
		--palette-dawn: #a28ec7;
		--palette-ocean: #0b757b;

		--color-ink: #0a3d40;
		--color-muted: #4a6b6e;
		--color-subtle: #7a9497;
		--color-paper: var(--palette-moonlight);
		--color-card: #ffffff;
		--color-card-tint: rgba(255, 255, 255, 0.78);
		--color-line: #d4c8e8;
		--color-primary: var(--palette-ocean);
		--color-primary-dark: #085a5f;
		--color-accent: var(--palette-dawn);
		--color-accent-soft: var(--palette-glacier);
		--color-tag-bg: var(--palette-frost);
		--color-on-primary: #ffffff;
		--color-body-glow: color-mix(in srgb, var(--palette-glacier) 55%, transparent);
		--color-body-mid: color-mix(in srgb, var(--palette-frost) 70%, var(--palette-moonlight));
		--color-body-end: #ffffff;
		--color-grid-line: color-mix(in srgb, var(--palette-ocean) 8%, transparent);
		--color-button-shadow: color-mix(in srgb, var(--palette-ocean) 28%, transparent);
		--shadow-soft: 0 24px 80px color-mix(in srgb, var(--palette-ocean) 14%, transparent);
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: var(--color-ink);
		background: var(--color-paper);
	}

	@media (prefers-color-scheme: dark) {
		:root {
			color-scheme: dark;
			--color-ink: var(--palette-moonlight);
			--color-muted: color-mix(in srgb, var(--palette-frost) 72%, var(--palette-dawn));
			--color-subtle: color-mix(in srgb, var(--palette-dawn) 65%, var(--palette-frost));
			--color-paper: #061a1c;
			--color-card: #0d2c2f;
			--color-card-tint: color-mix(in srgb, #0d2c2f 88%, var(--palette-ocean));
			--color-line: color-mix(in srgb, var(--palette-ocean) 35%, #1a3a3e);
			--color-primary: #2eb8bf;
			--color-primary-dark: #5ed0d6;
			--color-accent: var(--palette-glacier);
			--color-accent-soft: color-mix(in srgb, var(--palette-dawn) 40%, #0d2c2f);
			--color-tag-bg: color-mix(in srgb, var(--palette-ocean) 28%, #0d2c2f);
			--color-on-primary: #061a1c;
			--color-body-glow: color-mix(in srgb, var(--palette-ocean) 35%, transparent);
			--color-body-mid: color-mix(in srgb, #0a2427 80%, var(--palette-ocean));
			--color-body-end: #061a1c;
			--color-grid-line: color-mix(in srgb, var(--palette-glacier) 8%, transparent);
			--color-button-shadow: color-mix(in srgb, var(--palette-ocean) 40%, transparent);
			--shadow-soft: 0 24px 80px rgba(0, 0, 0, 0.45);
		}
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(circle at top left, var(--color-body-glow), transparent 36rem),
			linear-gradient(135deg, var(--color-paper) 0%, var(--color-body-mid) 42%, var(--color-body-end) 100%);
		color: var(--color-ink);
		font-size: 18px;
		line-height: 1.6;
	}

	body::before {
		position: fixed;
		inset: 0;
		z-index: -1;
		background-image: linear-gradient(var(--color-grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-grid-line) 1px, transparent 1px);
		background-size: 48px 48px;
		content: "";
		mask-image: linear-gradient(to bottom, black, transparent 80%);
	}

	a {
		color: var(--color-primary);
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	a:hover {
		color: var(--color-primary-dark);
	}

	img {
		max-width: 100%;
	}

	.container {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
	}

	.skip-link {
		position: absolute;
		top: 12px;
		left: 12px;
		z-index: 10;
		transform: translateY(-200%);
		border-radius: 999px;
		background: var(--color-ink);
		color: var(--color-paper);
		padding: 10px 16px;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.site-header {
		padding: 28px 0;
	}

	.header-grid,
	.footer-grid {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand-mark {
		display: block;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		overflow: hidden;
		object-fit: cover;
		object-position: center;
		flex-shrink: 0;
	}

	.brand-wordmark {
		display: flex;
		flex-direction: column;
		gap: 0;
		font-family: "Ubuntu", ui-sans-serif, system-ui, sans-serif;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1.05;
		text-transform: uppercase;
		color: var(--palette-dawn);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		padding: 8px 13px;
		color: var(--color-ink);
		font-size: 0.95rem;
		font-weight: 650;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current="page"] {
		background: var(--color-accent-soft);
		color: var(--color-primary-dark);
	}

	section {
		padding: 56px 0;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--color-primary);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		font-family: "Ubuntu", ui-sans-serif, system-ui, sans-serif;
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: 0.01em;
		text-wrap: balance;
	}

	h1 {
		max-width: 900px;
		font-size: clamp(2.5rem, 5vw, 4rem);
	}

	h2 {
		font-size: clamp(2.1rem, 5vw, 4rem);
	}

	h3 {
		font-size: clamp(1.35rem, 2vw, 1.8rem);
	}

	.lede {
		max-width: 760px;
		margin: 24px 0 0;
		color: var(--color-muted);
		font-size: clamp(1.2rem, 2vw, 1.5rem);
		line-height: 1.45;
	}

	.hero {
		padding: 88px 0 64px;
	}

	.hero-actions,
	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.button,
	.button-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		padding: 12px 18px;
		font-weight: 750;
		text-decoration: none;
	}

	.button {
		background: var(--color-primary);
		color: var(--color-on-primary);
		box-shadow: 0 14px 30px var(--color-button-shadow);
	}

	.button:hover {
		background: var(--color-primary-dark);
		color: var(--color-on-primary);
	}

	.button-secondary {
		border: 1px solid var(--color-line);
		background: var(--color-card-tint);
		color: var(--color-primary-dark);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.grid.two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.card,
	.panel {
		border: 1px solid var(--color-line);
		border-radius: 28px;
		background: var(--color-card-tint);
		box-shadow: var(--shadow-soft);
	}

	.card {
		padding: 28px;
	}

	.panel {
		padding: clamp(28px, 4vw, 48px);
	}

	.card p,
	.panel p,
	.legal p,
	.legal li {
		color: var(--color-muted);
	}

	.card h3 + p,
	.panel h2 + p {
		margin-top: 16px;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
	}

	.tag-list li {
		border: 1px solid var(--color-line);
		border-radius: 999px;
		background: var(--color-tag-bg);
		padding: 5px 10px;
		color: var(--color-primary-dark);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(28px, 6vw, 72px);
		align-items: start;
	}

	.list {
		display: grid;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.list li {
		border-left: 3px solid var(--color-accent);
		padding-left: 16px;
	}

	.site-footer {
		padding: 36px 0 48px;
		color: var(--color-muted);
		font-size: 0.92rem;
	}

	.footer-meta {
		display: grid;
		gap: 6px;
	}

	.site-footer p {
		margin: 0;
	}

	.footer-credit {
		font-size: 0.85rem;
		color: var(--color-subtle);
	}

	.footer-credit a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.footer-credit a:hover {
		color: var(--color-primary);
	}

	.site-footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.legal {
		max-width: 820px;
	}

	.legal dl {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 12px 24px;
		margin: 32px 0;
	}

	.legal dt {
		font-weight: 800;
	}

	.legal dd {
		margin: 0;
		color: var(--color-muted);
	}

	@media (max-width: 820px) {
		.header-grid,
		.footer-grid,
		.split {
			display: grid;
			grid-template-columns: 1fr;
		}

		.grid,
		.grid.two {
			grid-template-columns: 1fr;
		}

		section {
			padding: 40px 0;
		}

		.hero {
			padding-top: 48px;
		}
	}

	@media (max-width: 560px) {
		body {
			font-size: 16px;
		}

		nav a {
			padding: 7px 10px;
		}

		.legal dl {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-pop {
		from {
			opacity: 0;
			transform: scale(0.92);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.hero .container {
		animation: hero-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-actions {
		animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
	}

	.has-reveal .reveal {
		transition:
			opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			filter 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	.has-reveal .reveal:not(.is-visible) {
		opacity: 0;
		transform: translateY(1.35rem);
		filter: blur(4px);
	}

	.has-reveal .reveal.reveal-left:not(.is-visible) {
		transform: translateX(-1.5rem);
	}

	.has-reveal .reveal.reveal-right:not(.is-visible) {
		transform: translateX(1.5rem);
	}

	.has-reveal .reveal.reveal-scale:not(.is-visible) {
		transform: scale(0.96) translateY(0.75rem);
		filter: blur(3px);
	}

	.has-reveal .reveal.is-visible {
		opacity: 1;
		transform: none;
		filter: none;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		.hero .container,
		.hero-actions {
			animation: none;
		}

		.has-reveal .reveal,
		.has-reveal .reveal:not(.is-visible),
		.has-reveal .reveal.is-visible {
			opacity: 1;
			transform: none;
			filter: none;
			transition: none;
			will-change: auto;
		}
	}
</style>
