---
import Layout from '../../layouts/Layout.astro';
import { terms, type Locale } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const c = terms[locale];
---

<Layout title={c.title} description={c.description} locale={locale} pagePath="/terms/">
	<section class="hero">
		<div class="container legal">
			<p class="eyebrow">{c.eyebrow}</p>
			<h1>{c.h1}</h1>
		</div>
	</section>

	<section>
		<div class="container legal panel reveal">
			<p class="lede">{c.updated}</p>

			{c.intro.map((paragraph) => (
				<p>{paragraph}</p>
			))}

			{c.sections.map((section) => (
				<>
					<h2>{section.heading}</h2>
					{section.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</>
			))}

			<h2>{c.contactHeading}</h2>
			<p>
				{c.contactBefore}
				<a href="mailto:hola@mapache-soft.com">{c.contactLink}</a>
				{c.contactAfter}
			</p>
		</div>
	</section>
</Layout>
